   "source": [
    "def count_no_of_chars(s):\n",
    "    count={}\n",
    "    for i in s:\n",
    "        if i in count:\n",
    "            count[i]+=1\n",
    "        else:\n",
    "            count[i]=1\n",
    "    return count\n",
    "\n",
    "#s=['Hello','Hello','Kiran']\n",
    "s='Hello'\n",
    "count_no_of_chars(s)"
   ]
