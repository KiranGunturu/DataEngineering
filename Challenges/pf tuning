REPLACE:

DECLARE @str VARCHAR(35) = 'ABCDEFGH' 
SELECT @str, REPLACE(@str,'DEFGH','_REPLACE')

OUTPUT:ABC_REPLACE

SUBSTRING:

DECLARE @str VARCHAR(35) = 'ABCDEFGH' 
SELECT @str, SUBSTRING(@str,1,3) 
OUTPUT:ABC

