====================
Window Functions
====================

sytactic suger for complex queries

create table groceries
(
id string,
store string,
product string,
day date,
revenue double
)
row format delimited fields terminated by ',';

=========================
total table running sum:
=========================

select id,revenue,day,sum(revenue) over(order by day rows between unbounded preceding and current row) as running_total from groceries;

OR

rows between unbounded preceding and current row - this is the default behaviour so we can remove this.

select id,revenue,day,sum(revenue) over(order by day) as running_total from groceries;

===============================================
Instead of full table but do it per day basis
===============================================

select id,revenue,day,sum(revenue) over(partition by day order by id) as running_total from groceries;

**********what happens when we do NOT specify order by clause?**********

select id,revenue,day,sum(revenue) over(partition by day) as running_total from groceries; gives sum for each day.

if we do not give order by clause then the behaviour will be 

window size is from 1st row to last row.

rows between unbounded preceding and unbounded following.

================================
running total on count of orders
================================

select id,revenue,day,count(id) over(partition by day order by id) as running_total from groceries;

====================
Moving aggregations
====================

select id,revenue,day,sum(revenue) over(order by id rows between 3 preceding and current row) as running_total from groceries;

======
LEAD
======

select id,revenue,day,sum(revenue) over(order by id rows between 1 preceding and 1 preceding) as running_total from groceries;

======
LAG
======

select id,revenue,day,sum(revenue) over(order by rows between 1 following and 1 following) as running_total from groceries;


=======
RANKING
=======

select name,score,rank() over(order by score desc) as ranking from rank_test;

highest score will be rank 1

ties are assigned same rank with next ranking skipped


=============
DENSE RANKING
=============

select name,score,dense_rank() over(order by score desc) as ranking from rank_test;

highest score will be rank 1

ties are assigned same rank but next ranking is not skipped


===========
ROW_NUMBER
===========
select name,score,ROW_NUMBER() over(order by score desc) as ranking from rank_test;

=========================
PARTITION AND ROW_NUMBER
=========================


select name,score,ROW_NUMBER() over(partition by name order by score desc) as ranking from rank_test;

first it will group the records by name and assign row numbers for each group based on score.


